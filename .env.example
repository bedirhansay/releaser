# ---- Database ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/releaser?schema=public"

# ---- Auth.js ----
# Generate with: npx auth secret  (or `openssl rand -base64 32`)
AUTH_SECRET="replace-me"
# Optional; Auth.js infers this in most cases. Set explicitly in production.
# AUTH_URL="http://localhost:3000"

# ---- Superadmin seed (org bootstrap) ----
# `pnpm db:seed` creates the default Organization and a superadmin (OWNER) that
# logs in with email + password. Change the password after first login.
SUPERADMIN_EMAIL="admin@mersel.io"
SUPERADMIN_PASSWORD="change-me-strong-password"
# Optional: name + slug of the default organization.
ORG_NAME="Mersel"

# ---- At-rest encryption for OAuth tokens (REQUIRED) ----
# Releaser encrypts GitConnection.accessToken with AES-256-GCM using a key
# derived from this value. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY="replace-me-with-32-bytes-of-random"

# ---- GitHub OAuth App ----
# Create at: https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ---- GitHub App (Coolify-style repo access) ----
# OPTIONAL but recommended for production. Login stays on OAuth above; this App
# grants fine-grained, per-repo, read-only access via short-lived tokens — the
# user chooses which repos at install time.
#
# Create at: https://github.com/settings/apps/new
#   - Callback / Setup URL: https://YOUR_DOMAIN/api/github/app/callback
#   - Webhook URL:          https://YOUR_DOMAIN/api/github/app/webhook
#   - Permissions (read-only): Contents, Metadata, Pull requests
#   - After creating: note the App ID, generate a private key (.pem), and copy
#     the app "slug" from its public page URL (github.com/apps/<slug>).
GITHUB_APP_ID=""
# Paste the PEM contents. Newlines may be real or escaped as \n on one line.
GITHUB_APP_PRIVATE_KEY=""
GITHUB_APP_SLUG=""
GITHUB_APP_CLIENT_ID=""
GITHUB_APP_CLIENT_SECRET=""
GITHUB_APP_WEBHOOK_SECRET=""

# ---- Bitbucket OAuth Consumer ----
# Create at: Workspace Settings → OAuth consumers
# Callback URL: http://localhost:3000/api/auth/callback/bitbucket
# Permissions: Account (read), Repositories (read)
AUTH_BITBUCKET_ID=""
AUTH_BITBUCKET_SECRET=""

# ---- AI provider ----
# Works with OpenAI itself OR any OpenAI-compatible endpoint:
#   Z.AI (GLM):           AI_BASE_URL=https://api.z.ai/api/paas/v4        AI_MODEL=glm-4.6
#   Zhipu open platform:  AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4 AI_MODEL=glm-4-flash
#   DeepSeek:             AI_BASE_URL=https://api.deepseek.com/v1         AI_MODEL=deepseek-chat
#   Together:             AI_BASE_URL=https://api.together.xyz/v1
#   Groq:                 AI_BASE_URL=https://api.groq.com/openai/v1
#   Local Ollama:         AI_BASE_URL=http://localhost:11434/v1           AI_MODEL=llama3
#
# For plain OpenAI: leave AI_BASE_URL empty.
#
# NOTE: AI is now bring-your-own-key per user (Settings → AI). These AI_* values
# act as a shared fallback when a user hasn't configured their own key.
AI_API_KEY=""
AI_BASE_URL=""
AI_MODEL="gpt-4o-mini"

# ---- Distributed rate-limit / quota (optional) ----
# When both are set, AI generation rate limits + daily quota coordinate across
# instances via Upstash Redis (REST). Leave empty for single-instance / local
# dev — the limiter falls back to in-process counters.
# Create at: https://console.upstash.com (Redis → REST API)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
