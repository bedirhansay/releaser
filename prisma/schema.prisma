// Releaser — Prisma schema
// Minimal models for MVP: User + Auth.js + GitConnection + ReleaseHistory.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: connection URL lives in prisma.config.ts (for migrations) and is
// passed to PrismaClient via the @prisma/adapter-pg driver adapter.
datasource db {
  provider = "postgresql"
}

// ---------- Org / RBAC ----------
// Roles are scoped to an organization via Membership. OWNER is the top role
// (cannot be removed if last); ADMIN manages members/groups/projects; MEMBER
// only sees projects granted to them (directly or via a group).
enum Role {
  OWNER
  ADMIN
  MEMBER
}

// A tenant. Resources (projects, templates, releases, git/AI connections) are
// owned by an Organization, not an individual — so a team shares one set.
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships     Membership[]
  groups          Group[]
  projects        Project[]
  templates       ReleaseTemplate[]
  releases        ReleaseHistory[]
  gitConnections  GitConnection[]
  ghInstallations GitHubInstallation[]
  aiSetting       AiSetting?
}

// Links a user to an organization with a role.
model Membership {
  id        String   @id @default(cuid())
  userId    String
  orgId     String
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
}

// A named group of members within an org (e.g. "frontend"). Groups can be
// granted access to projects, so access is managed per-team, not per-person.
model Group {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org     Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members GroupMember[]
  access  ProjectAccess[]

  @@unique([orgId, name])
  @@index([orgId])
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

// Grants a project to a group OR an individual user. Exactly one of groupId /
// userId is set per row (the null column lets the unique index coexist).
model ProjectAccess {
  id        String   @id @default(cuid())
  projectId String
  groupId   String?
  userId    String?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, groupId])
  @@unique([projectId, userId])
  @@index([projectId])
  @@index([groupId])
  @@index([userId])
}

// ---------- Auth.js (NextAuth) models ----------
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  // Set for credentials (email/password) login — e.g. the seeded superadmin
  // and admin-provisioned members. Null for OAuth-only identities.
  passwordHash  String?

  accounts         Account[]
  sessions         Session[]
  memberships      Membership[]
  groupMemberships GroupMember[]
  projectAccess    ProjectAccess[]
  createdProjects  Project[]         @relation("ProjectCreatedBy")
  createdTemplates ReleaseTemplate[] @relation("TemplateCreatedBy")
  createdReleases  ReleaseHistory[]  @relation("ReleaseCreatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A GitHub App installation a user has connected (Coolify-style). Repo access
// uses short-lived installation tokens minted from the App's private key — the
// user picks exactly which repos to grant during install. OAuth stays for
// login/identity; this grants repo data access.
model GitHubInstallation {
  id                  String   @id @default(cuid())
  orgId               String
  installationId      Int      @unique
  accountLogin        String?
  accountType         String?
  repositorySelection String?
  suspended           Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

// Per-user "bring your own LLM" configuration. The API key is encrypted at
// rest with the same AES-256-GCM cipher used for OAuth tokens. When absent,
// generation falls back to the shared AI_* environment values.
model AiSetting {
  id           String   @id @default(cuid())
  orgId        String   @unique
  apiKeyCipher String?  @db.Text
  baseUrl      String?
  model        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Domain models ----------
enum GitProviderKind {
  GITHUB
  BITBUCKET
  GITLAB
  LOCAL
}

model GitConnection {
  id           String          @id @default(cuid())
  orgId        String
  provider     GitProviderKind
  accountLogin String?
  accessToken  String          @db.Text
  scope        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, provider])
}

// ---------- Projects & templates ----------

// A Project bundles one or more repositories (e.g. "finsel" = backend +
// frontend) so a single release can span them all.
model Project {
  id          String   @id @default(cuid())
  orgId       String
  createdById String?
  name        String
  slug        String?
  description String?
  // Release-doc metadata: defaults injected into generated release documents.
  // defaultRisk e.g. "MEDIUM"; monitoringLinks + signOff are newline-separated
  // free text (one "Label: URL" / "Role: Name" per line).
  defaultRisk     String?
  monitoringLinks String? @db.Text
  signOff         String? @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org       Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy User?             @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  repos     ProjectRepo[]
  templates ReleaseTemplate[]
  releases  ReleaseHistory[]
  access    ProjectAccess[]

  @@unique([orgId, name])
  @@index([orgId])
}

// A repository inside a Project, optionally role-tagged ("backend",
// "frontend", …) so the AI and UI can group changes by surface.
model ProjectRepo {
  id        String          @id @default(cuid())
  projectId String
  provider  GitProviderKind
  owner     String
  name      String
  role      String?
  createdAt DateTime        @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, provider, owner, name])
  @@index([projectId])
}

// A user-editable release template. `sections` is an ordered JSON list of
// { id, heading, instruction } entries — the AI fills each section's content
// at generate time, so the document structure is whatever the user defines.
model ReleaseTemplate {
  id          String   @id @default(cuid())
  orgId       String
  createdById String?
  projectId   String?
  name        String
  description String?
  sections    Json
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy User?        @relation("TemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  project   Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([projectId])
}

model ReleaseHistory {
  id          String          @id @default(cuid())
  orgId       String
  createdById String?
  projectId   String?
  templateId  String?
  provider    GitProviderKind
  repoOwner   String
  repoName    String
  baseRef     String
  headRef     String
  title       String?
  // Free-form, user-authored labels (e.g. "backend", "frontend"). Scalar
  // string list — Postgres-native, no join table needed for this scale.
  tags        String[]        @default([])
  markdown    String          @db.Text
  // Snapshot of structured payload returned from the engine (categorized notes,
  // risks, model used). Stored as JSON for flexibility — schema may evolve.
  payload     Json
  modelUsed   String?
  createdAt   DateTime        @default(now())

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy User?        @relation("ReleaseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  project   Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([orgId, repoOwner, repoName])
  @@index([projectId])
}
